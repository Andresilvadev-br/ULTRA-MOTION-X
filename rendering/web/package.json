{
  "name": "@ultra-motion-x/effects",
  "version": "1.0.0",
  "description": "Ultra Motion X Hyper Render effects: WebGL2/WebGPU shader materials (glass, ripple, gradient, lighting, noise, refraction) with fidelity scaling and CSS fallbacks.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "umx-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "peerDependencies": {
    "@ultra-motion-x/web": "^1.0.0"
  },
  "devDependencies": {
    "@ultra-motion-x/web": "1.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "node --conditions=umx-source --test test/*.test.ts"
  }
}
